# =============================================================================
# Chaptr — Environment Configuration Template
# =============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Never commit real keys, tokens, or `.env.local` to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Public Application & Supabase Configuration
# -----------------------------------------------------------------------------

# Canonical origin of your Chaptr deployment.
# Use http://localhost:3000 for local development, or your production URL
# (e.g., https://www.chaptr.space) when self-hosting.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Your Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Preferred Supabase publishable key (Project Settings -> API -> Publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Optional legacy fallback if your Supabase setup uses the anon key instead
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# -----------------------------------------------------------------------------
# 2. Server-Only Secrets (NEVER expose to client bundles or NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------

# Supabase service-role key used on the server for deterministic academic
# catalog seeding (/api/sync/bootstrap) and scheduled account deletion cleanup.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_replace_me"

# Server-side encryption key (use a random 32+ byte string, e.g.: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY="replace-with-random-32-byte-secret"

# -----------------------------------------------------------------------------
# 3. Supabase Edge Functions (supabase/functions/process-account-deletions)
# -----------------------------------------------------------------------------
# Auto-injected in hosted Supabase Edge Runtime; set manually only when running
# functions outside standard Supabase hosting.
# SUPABASE_URL="https://your-project-ref.supabase.co"
